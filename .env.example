# Montauk reads all secrets and operational settings from the environment,
# never from a config file. Copy this to .env (gitignored) and fill in
# real values, or set them directly in your process environment.

# PostgreSQL DSN for the canonical store. Required by every command.
MONTAUK_DATABASE_URL=postgresql://montauk:montauk@localhost:5432/montauk

# Secret-encryption master key: 32 bytes, base64. Encrypts stored
# model-provider API keys; without it, briefings fall back to the
# deterministic evidence packet. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MONTAUK_MASTER_KEY=

# Public URL the dashboard is reached at, behind a reverse proxy
# (e.g. https://montauk.example.com). Optional.
MONTAUK_PUBLIC_URL=

# --- WhatsApp inbound connector (optional) ---------------------------
# The dashboard drives a receive-only Baileys sidecar (sidecars/whatsapp).
# Set both to enable the connector; the sidecar must use the same token.
# Requires MONTAUK_MASTER_KEY (the linked-device session is stored encrypted).
MONTAUK_WA_SIDECAR_URL=http://127.0.0.1:8766
MONTAUK_WA_SIDECAR_TOKEN=
# Set to 0 to stop this process from running the connector sync loop
# (e.g. on the MCP process when the dashboard already runs it).
MONTAUK_RUN_CONNECTORS=1
