# Montauk reads secrets from environment variables, never from YAML or
# Markdown (spec section 30). Copy this file to .env (or otherwise set
# these in your process environment) and fill in real values -- .env
# itself is gitignored.

# Bearer token for the single agent connecting over stdio transport.
# Not used/needed for the "remote" transport, where each HTTP request
# carries its own Authorization header instead. Generate one with:
#   montauk agents create --name my-agent --role read_write
MONTAUK_AGENT_TOKEN=

# --- Phase 2 (PostgreSQL canonical store + dashboard) ---

# PostgreSQL DSN for the Phase 2 canonical store. Required by
# `montauk db ...`, `montauk migrate phase2 ...`, and `montauk dashboard`.
MONTAUK_DATABASE_URL=postgresql://montauk:montauk@localhost:5432/montauk

# Application-level secret-encryption master key: 32 bytes, base64. Not yet
# used to store anything (no connector/LLM credentials in this increment)
# but the dashboard's SecretBox needs it once those land. Generate with:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MONTAUK_MASTER_KEY=
